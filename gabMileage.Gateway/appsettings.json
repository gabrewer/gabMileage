{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WorkOS": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "",
    "JwtAuthority": "",
    "Audience": "",
    "AuthorizationEndpoint": "https://api.workos.com/...",
    "TokenEndpoint": "https://api.workos.com/...",
    "RefreshSkewSeconds": 300
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "web": {
        "ClusterId": "web",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "web": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:3000/"
          }
        }
      }
    }
  }
}
